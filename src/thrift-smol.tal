|10 @Console/vector-hi $1 &vector-lo $1 &read

|100
@on-reset   ( -> ) !/reset
&quote      ( -> ) .Console/read DEI ( >> )
&reset      ( -> ) ;on-console .Console/vector-hi DEO2 BRK
@on-console ( -> ) .Console/read DEI JMPk
&unquote    ( -> ) STR $1 BRK
&quote      ( -> ) .Console/vector-lo DEO BRK
