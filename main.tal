@on-reset ( -> )
    #ffcb :asm/move                          ( move thrift to the top of RAM )
	:asm/reset                               ( reset assembler pointer to :0100 )
	:asm/get                                 ( get assembler pointer value )
    ;FizzBuzz ;FizzBuzz/end :asm/copy-blk    ( copy code )
    [ :LIT 10 ] EMIT2 :JSR2                  ( call fizzbuzz )
    :DBG [ :LIT 80 ] :HLT                    ( debug and exit )
	BRK

@FizzBuzz ( -> )
	@fizzbuzz ( n -- )
		#01
	    &>loop ( length i -- )
	        DUP fizz OVR buzz ORA ?{ DUP <dec> }
	        [ LIT2 0a -Console/error ] DEO
	        INC GTHk ?&>loop
	    POP2 JMP2r

	%MOD ( a b -- a%b ) { DIVk MUL SUB }
	@fizz ( n -- ) #03 MOD ?{ #01 { "Fizz $1 } STH2r !<str> } #00 JMP2r
	@buzz ( n -- ) #05 MOD ?{ #01 { "Buzz $1 } STH2r !<str> } #00 JMP2r
	%ERR ( a -- ) { .Console/error DEO }
	@<dec> ( n -- ) DUP #0a DIV /d #0a MOD &d #30 ADD ERR JMP2r
	@<str> ( s* -- ) LDAk ERR INC2 LDAk ?<str> POP2 JMP2r
@FizzBuzz/end
